APP_ENV=production
BIND_ADDRESS=0.0.0.0
PORT=8080
DATA_DIR=/data
SQLITE_PATH=/data/weather.db
ASSET_DIR=/data/assets
INBOX_DIR=/data/inbox
INGEST_MODE=http
INGEST_TOKEN=replace-with-at-least-32-random-characters
READ_API_TOKEN=
DISPLAY_ROTATE_SECONDS=5
DISPLAY_REFRESH_SECONDS=30
RADAR_FRAME_SECONDS=1
DATA_STALE_MINUTES=20
RETENTION_DAYS=30
RADAR_RETENTION_HOURS=72
MAX_REQUEST_MB=25
MAX_ASSET_MB=20
TIMEZONE=Asia/Seoul
KMA_SERVICE_KEY=
KMA_ENDPOINT=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_POLL_SECONDS=3600
KMA_APIHUB_KEY=
KMA_APIHUB_ENDPOINT=https://apihub.kma.go.kr
KMA_APIHUB_POLL_SECONDS=600
LOG_LEVEL=info
DEMO_MODE=false
# HOST_IP/HOST_PORT are Compose host-side values
HOST_IP=0.0.0.0
HOST_PORT=8080
